{
  "uid": "nw-lb-red",
  "title": "nw-lb-go RED",
  "description": "Rate, Errors and Duration for the nw-lb-go gRPC load balancer, plus the resilience signals that explain them. The datasource uid must match deploy/grafana/provisioning/datasources/prometheus.yml.",
  "tags": ["nw-lb-go", "red", "grpc", "slo"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"]
  },
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "method",
        "label": "Method",
        "description": "Full gRPC method, e.g. /echo.v1.EchoService/Echo. Applies to the Rate, Errors and Duration rows.",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
        "definition": "label_values(lb_requests_total, method)",
        "query": {
          "qryType": 1,
          "query": "label_values(lb_requests_total, method)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Rate",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by method",
      "description": "Throughput the load balancer accepted, including requests that later failed. This is the R in RED.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisSoftMin": 0,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "sum by (method) (rate(lb_requests_total{method=~\"$method\"}[1m]))",
          "legendFormat": "{{method}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Upstream rate by backend",
      "description": "Calls actually forwarded, per backend. Diverges from the request rate by exactly the retries: a failover counts once at the LB and twice upstream.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "normal", "group": "A" },
            "thresholdsStyle": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "sum by (backend) (rate(lb_upstream_requests_total[1m]))",
          "legendFormat": "{{backend}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total RPS",
      "description": "sum(rate(lb_requests_total[1m])) across the selected methods.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(lb_requests_total{method=~\"$method\"}[1m]))",
          "legendFormat": "rps",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error ratio",
      "description": "Non-OK responses as a fraction of all responses. The dashed line is the 1% alerting threshold used by LBHighErrorRatio. A ratio survives traffic swings that a raw error rate would not.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMax": 0.05,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "dashed" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(lb_requests_total{method=~\"$method\",code!=\"OK\"}[1m])) / sum(rate(lb_requests_total{method=~\"$method\"}[1m]))",
          "legendFormat": "error ratio",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors by gRPC code",
      "description": "Which failure it is decides who owns it: Unavailable and DeadlineExceeded are upstream or capacity problems, ResourceExhausted is the rate limiter, InvalidArgument and NotFound are the caller's.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 25,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "normal", "group": "A" },
            "thresholdsStyle": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "sum by (code) (rate(lb_requests_total{method=~\"$method\",code!=\"OK\"}[1m]))",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Error ratio (5m)",
      "description": "Same ratio the LBHighErrorRatio alert evaluates, over its window. Turns red at 1%.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": { "text": "no traffic", "color": "text", "index": 0 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(lb_requests_total{method=~\"$method\",code!=\"OK\"}[5m])) / sum(rate(lb_requests_total{method=~\"$method\"}[5m]))",
          "legendFormat": "error ratio",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Duration",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request latency percentiles (p50 / p95 / p99)",
      "description": "End-to-end latency measured by the LB's Metrics interceptor. The red threshold line is the 200ms SLO; 0.2 is an exact histogram bucket boundary, so p99 is not interpolated across it. Aggregate the buckets before taking the quantile, never average pre-computed quantiles.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "latency",
            "axisSoftMax": 0.25,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "line" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "red" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "orange" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "green" }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(lb_request_duration_seconds_bucket{method=~\"$method\"}[1m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lb_request_duration_seconds_bucket{method=~\"$method\"}[1m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(lb_request_duration_seconds_bucket{method=~\"$method\"}[1m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Upstream p99 by backend",
      "description": "Where the tail comes from. A single slow backend shows here long before it moves the aggregate p99 above, because consistent hashing sends it only its share of keys.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMax": 0.25,
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" },
            "thresholdsStyle": { "mode": "line" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["max", "lastNotNull"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, backend) (rate(lb_upstream_duration_seconds_bucket[1m])))",
          "legendFormat": "{{backend}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Under 200ms SLO (5m)",
      "description": "Read straight off the le=\"0.2\" bucket rather than from an interpolated quantile: sum(rate(bucket{le=\"0.2\"})) / sum(rate(count)). Green at or above 99%.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 9, "w": 4, "x": 20, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.98 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": { "text": "no traffic", "color": "text", "index": 0 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(lb_request_duration_seconds_bucket{method=~\"$method\",le=\"0.2\"}[5m])) / sum(rate(lb_request_duration_seconds_count{method=~\"$method\"}[5m]))",
          "legendFormat": "under SLO",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 400,
      "type": "row",
      "title": "Backends and resilience",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "panels": []
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Backend health",
      "description": "lb_backend_healthy, as decided by the LB's own gRPC health checker with rise/fall flap damping. This is the LB's opinion, which is what routing acts on; `up` from Prometheus is a separate question.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 75,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "unhealthy", "color": "red", "index": 0 },
                "1": { "text": "healthy", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "perPage": 20,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
          "editorMode": "code",
          "expr": "lb_backend_healthy",
          "legendFormat": "{{backend}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Circuit breaker state",
      "description": "lb_circuit_state per breaker: 0 closed, 1 open, 2 half-open. Open means the LB is fail-fasting with Unavailable instead of spending capacity on a dependency that is already failing.",
      "datasource": { "type": "prometheus", "uid": "nw-lb-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "color": { "mode": "thresholds" },
          "custom": {
